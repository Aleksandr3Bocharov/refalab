//====================================================================
// Refal functions of the RefalAB library.
// Specifiers of the RefalAB library.
// Empty functions of the RefalAB library (they only fail).
// The module "PLATFORM" with the platform-specific Refal functions
// and specifiers for the POSIX environment.
// A similar module is used for the Windows environment.
//====================================================================

$START PLATFORM;

$ENTRY Platform, POSIX, Windows; 
$ENTRY Directory_Separators, Directory_Separator, Is_Directory_Separator;
$ENTRY Path_Separator;
$ENTRY Max_PathFileName, Get_Max_PathFileName, Is_Max_PathFileName;
$EXTERN True, False;
$EMPTY POSIX, Windows;

// The specifier Directory_Separators: the characters that separate the directories in a path (POSIX).
$SPEC Directory_Separators '/';

// The specifier Max_PathFileName: the largest length of a path with a file name (POSIX).
$SPEC Max_PathFileName 4096;

// The name of the platform: the label POSIX or Windows.
$FUNC Platform
{
    = POSIX;
}

// The main directory separator.
$FUNC Directory_Separator
{
    = '/';
}

// True when the symbol is a directory separator.
$FUNC Is_Directory_Separator
{
    s(:Directory_Separators:)._ = True;
    s._ = False;
}

// The separator of the paths in a list of paths.
$FUNC Path_Separator
{
    = ':';
}

// The largest length of a path with a file name.
$FUNC Get_Max_PathFileName
{
    = 4096;
}

// True when the symbol is the largest length of a path with a file name.
$FUNC Is_Max_PathFileName
{
    s(:Max_PathFileName:)._ = True;
    s._ = False;
}

$END.
