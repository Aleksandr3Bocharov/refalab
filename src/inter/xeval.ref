//====================================================================
// Refal functions of the RefalAB library.
// Empty functions of the RefalAB library (they only fail).
//====================================================================

$START EVAL;

$ENTRY Eval, Call;
$EMPTY Call;

/*
    <Eval e.Any> = e.Eval
*/
// Evaluates the expression: every bracketed term (Call e.Call) is replaced by the call < e.Call > evaluated,
// other brackets are processed inside, symbols stay as they are. It is used to compute
// delayed calls (the conditions of If, And, Or).
$FUNC Eval
{ 
    = ;
    s.Symbol e.Rest = s.Symbol <Eval e.Rest>;
    (Call e.Call) e.Rest = < <Eval e.Call>> <Eval e.Rest>;
    (e.Inner) e.Rest = (<Eval e.Inner>) <Eval e.Rest>;
}

$END.
