//====================================================================
// Рефал-функции библиотеки РефалАБ.
// Пустые функции библиотеки РефалАБ.
//====================================================================

$START EVAL;

$ENTRY Eval, Call;
$EMPTY Call;

/*
    <Eval e.Any> = e.Eval
*/
$FUNC Eval
{ 
    = ;
    s.Symbol e.Rest = s.Symbol <Eval e.Rest>;
    (Call e.Call) e.Rest = < <Eval e.Call>> <Eval e.Rest>;
    (e.Inner) e.Rest = (<Eval e.Inner>) <Eval e.Rest>;
}

$END.
