//====================================================================
// Refal functions of the RefalAB library.
// Empty functions of the RefalAB library (they only fail).
// Specifiers of the RefalAB library.
//====================================================================

$START BOOL2;

$ENTRY True, False, Bool;
$ENTRY If, And, Or, Not;
$EXTERN Eval;
$EMPTY True, False;

// The specifier Bool: True or False.
$SPEC Bool True False;

/*
    <If (v.Cond e.Any)+ (e.Any)> = e.Any
    v.Cond ::= True | False | (e.Any)
*/
// Conditional: the pairs (condition expression) are checked in turn; the expression of the first true
// condition is evaluated (Eval), the last bracketed term is the one for the case when all the conditions are False.
$FUNC If  
{
    e(b).CExp = <If_Aux e.CExp>;
}

// The loop of If: a condition True or False, or a delayed call in brackets that is evaluated and checked by BCheck.
$FUNC If_Aux 
{
    (True e.Expr) e._ w.False = <Eval e.Expr>;
    (False e._) (e.False) = <Eval e.False>;
    (False e._) e.Rest w.False = <If_Aux e.Rest w.False>;
    ((e.BExp) e.Expr) e.Rest w.False = <If_Aux (<BCheck <Eval e.BExp>> e.Expr) e.Rest w.False>;
}

// Checks that the value of a condition is True or False (the specifier Bool); FAIL otherwise.
$FUNC BCheck
{
    s(:Bool:).Bool = s.Bool;
}

//  <And e(:Bool: b).BExp> = True | False
// The logical And of the conditions; the conditions are evaluated one after another and the first False ends it.
$FUNC And
{
    e(:Bool: b).BExp = <And_Aux e.BExp>;
}

// The loop of And.
$FUNC And_Aux 
{
    = True;
    False e._ = False;
    True e.BExp = <And_Aux e.BExp>;
    (e.Exp) e.BExp_E = <And_Aux <BCheck <Eval e.Exp>> e.BExp_E>;
}

//  <Or e(:Bool: b).BExp> = True | False
// The logical Or of the conditions; the first True ends it.
$FUNC Or 
{  
    e(:Bool: b).BExp = <Or_Aux e.BExp>;
}

// The loop of Or.
$FUNC Or_Aux 
{ 
    = False;
    True e._ = True;
    False e.BExp = <Or_Aux e.BExp>;
    (e.Exp) e.BExp_E = <Or_Aux <BCheck <Eval e.Exp>> e.BExp_E>;
}

//  <Not s(:Bool:).Bool> = True | False
// The logical Not.
$FUNC Not 
{
    True = False;
    False = True;
}

$END.
