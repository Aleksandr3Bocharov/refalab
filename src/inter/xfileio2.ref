//====================================================================
// Refal functions of the RefalAB library.
// Specifiers of the RefalAB library.
//====================================================================

$START FILEIO2;

$ENTRY EOF;
$ENTRY Load_File, Save_File, Append_File;
$ENTRY Load_FBytes, Save_FBytes, Append_FBytes;
$EXTERN FOpen, FClose, FGetS, FPutS, FRead, FWrite, FEOF, FError;
$EXTERN NULL;

// The specifier EOF: the label FEOF or FError, which the file functions return at the end of the file or on an error.
$SPEC EOF FEOF FError;

/*
    <Load_File s(n).Handle e(o).FileName> == v.Out
    v.Out ::= NULL | v(o).Open_Error NULL | e.Lines s(:EOF:).EOF e(o).Close_Error
    e.Lines ::= (e(o).Line)*
*/
// Reads the whole text file (line by line, in the text mode) into the lines in brackets. The result ends with the label FEOF
// or FError (the specifier EOF) and the result of closing the file; NULL is returned when the number is
// already used and an open error (the text of it) when the file cannot be opened.
$FUNC Load_File
{
    s.Handle e.FileName =
        <Check_Open <FOpen 'r' s.Handle e.FileName> s.Handle>;
}

// Goes on to read the file only if it was opened (an open error is returned as it is).
$FUNC Check_Open
{
    NULL e._ = NULL;
    e.Open_Error s.Handle = e.Open_Error
        <Load_File_Aux s.Handle <FGetS s.Handle>>
        <FClose s.Handle>;
}

// Reads the lines one by one up to the end of the file.
$FUNC Load_File_Aux 
{
    e._ NULL = ;
    s._ s(:EOF:).EOF = s.EOF;
    s._ e.Line s(:EOF:).EOF = (e.Line) s.EOF;
    s.Handle e.Line = (e.Line) <Load_File_Aux s.Handle <FGetS s.Handle>>;
}

/*
    <Save_File s(n).Handle (e(o).FileName) e.Lines> == e.Out
    e.Lines ::= (e(o).Line)*
    e.Out ::= NULL | v(o).Open_Error NULL | e(:EOF:).EOF e(o).Close_Error
*/
// Writes the lines to a new text file (an existing one is overwritten) and closes it.
$FUNC Save_File
{
    s.Handle (e.FileName) e.Lines =
        <Check_Lines e.Lines>
        <Check_Open_Write_Lines <FOpen 'w' s.Handle e.FileName> s.Handle (e.Lines)>;
}

/*
    <Append_File s(n).Handle (e(o).FileName) e.Lines> == e.Out
    e.Lines ::= (e(o).Line)*
    e.Out ::= NULL | v(o).Open_Error NULL | e(:EOF:).EOF e(o).Close_Error
*/
// Appends the lines to the end of the text file.
$FUNC Append_File
{
    s.Handle (e.FileName) e.Lines =
        <Check_Lines e.Lines>
        <Check_Open_Write_Lines <FOpen 'a' s.Handle e.FileName> s.Handle (e.Lines)>;
}

// Writes the lines only if the file was opened.
$FUNC Check_Open_Write_Lines
{
    NULL e._ = NULL;
    e.Open_Error s.Handle (e.Lines) = e.Open_Error
        <Write_Bracket_Lines s.Handle e.Lines>
        <FClose s.Handle>;
}

// Checks that the argument is a sequence of bracketed lines of characters; FAIL otherwise.
$FUNC Check_Lines
{
    = ;
    (e(o).Line) e.Rest_Lines = <Check_Lines e.Rest_Lines>;
}

// Writes the lines one by one, each followed by a line feed.
$FUNC Write_Bracket_Lines
{
    s._ = ;
    s.Handle (e.Line) e.Rest_Lines = <Write_Bracket_Lines_Aux <FPutS s.Handle e.Line '\n'> s.Handle e.Rest_Lines>;
}

// Stops on the first error of writing.
$FUNC Write_Bracket_Lines_Aux
{
    NULL e._ = ;
    s(:EOF:).EOF e._ = s.EOF;
    e._ = <Write_Bracket_Lines e._>;
}

/*
    <Load_FBytes s(n).Handle e(o).FileName> == v.Out
    v.Out ::= NULL | v(o).Open_Error NULL | e.Bytes s(:EOF:).EOF e(O).Close_Error
    e.Bytes ::= s(n).Byte*
*/
// Reads the whole file in the binary mode as macrodigits (bytes), by blocks of 4096 bytes.
$FUNC Load_FBytes
{
    s.Handle e.FileName =
        <Check_Open_FBytes <FOpen 'rb' s.Handle e.FileName> s.Handle>;
}

// Goes on to read the file only if it was opened.
$FUNC Check_Open_FBytes
{
    NULL e._ = NULL;
    e.Open_Error s.Handle = e.Open_Error
        <Load_FBytes_Aux s.Handle <FRead s.Handle 4096>>
        <FClose s.Handle>;
}

// Reads the blocks up to the end of the file.
$FUNC Load_FBytes_Aux
{
    e._ NULL = ;
    s._ e.Bytes s(:EOF:).EOF = e.Bytes s.EOF;
    s.Handle e.Bytes = e.Bytes <Load_FBytes_Aux s.Handle <FRead s.Handle 4096>>;
}

/*
    <Save_FBytes s(n).Handle (e(o).FileName) e.Bytes> == e.Out
    e.Bytes ::= s(on).Byte*
    e.Out ::= NULL | v(o).Open_Error NULL | e(:EOF:).EOF e(o).Close_Error
*/
// Writes the bytes to a new binary file (an existing one is overwritten) and closes it.
$FUNC Save_FBytes
{
    s.Handle (e.FileName) e(on).Bytes =
        <Check_Open_Write_Bytes <FOpen 'wb' s.Handle e.FileName> s.Handle (e.Bytes)>;
}

/*
    <Append_FBytes s(n).Handle (e(o).FileName) e.Bytes> == e.Out
    e.Bytes ::= s(on).Byte*
    e.Out ::= NULL | v(o).Open_Error NULL | e(:EOF:).EOF e(o).Close_Error
*/
// Appends the bytes to the end of the binary file.
$FUNC Append_FBytes
{
    s.Handle (e.FileName) e(on).Bytes =
        <Check_Open_Write_Bytes <FOpen 'ab' s.Handle e.FileName> s.Handle (e.Bytes)>;
}

// Writes the bytes only if the file was opened.
$FUNC Check_Open_Write_Bytes
{
    NULL e._ = NULL;
    e.Open_Error s.Handle (e.Bytes) = e.Open_Error
        <Write_FBytes <FWrite s.Handle e.Bytes>>
        <FClose s.Handle>;
}

// Returns the result of writing as it is, an empty one when the write is good.
$FUNC Write_FBytes
{
    NULL = ;
    e._ = e._;
}

$END.