//====================================================================
// Refal functions of the RefalAB library.
// Specifiers of the RefalAB library.
// Empty functions of the RefalAB library (they only fail).
//====================================================================

$START LEXICAL2;

$ENTRY Cvb, Cvd;
$ENTRY White_Spaces, Is_White_Space, Trim, TrimL, TrimR;
$ENTRY Type, Is_Type;
$ENTRY Void, Label, Number, Reference, Latin, Digit, Char, Brackets, OtherT;
$EXTERN Numb, Symb, Add, Mul, DrN;
$EXTERN True, False;
$EMPTY Void, Label, Number, Reference, Latin, Digit, Char, Brackets, OtherT;

// The specifier White_Spaces: a blank, a line feed, a horizontal and a vertical tab, a form feed and a carriage return.
$SPEC White_Spaces ' \n\t\v\f\r';

// Cvb: converts a string of decimal digits with an optional sign into a long integer (see Cvb0).
$FUNC Cvb 
{
    '-' v('0').X = 0;
    '-' v(d).X = '-' <Cvb0 v.X>;
    '+' v(d).X = <Cvb0 v.X>;
    e(d).X = <Cvb0 e.X>;
}

// Converts digits to a number by groups of nine: the number is the previous groups multiplied
// by 10^9 plus the last group, which is converted by Numb.
$FUNC Cvb0
{
    v.X s.D1 s.D2 s.D3 s.D4 s.D5 s.D6 s.D7 s.D8 s.D9 = 
        <Add (<Mul (<Cvb0 v.X>) 1000000000>) 
            <Numb <Strip_Zeros s.D1 s.D2 s.D3 s.D4 s.D5 s.D6 s.D7 s.D8 s.D9>>>;
    e.X = <Numb <Strip_Zeros e.X>>;
}

// Drops the leading zero digits (Numb would take them for an octal prefix).
$FUNC Strip_Zeros
{
    '0' e.X = <Strip_Zeros e.X>;
    e.X = e.X;
}

// Cvd: converts a long integer into a string of decimal digits (the reverse of Cvb).
$FUNC Cvd 
{
    '-' v(0).X = '0';
    '-' v(n).X = '-' <Cvd0 v.X>;
    '+' v(n).X = <Cvd0 v.X>;
    e(n).X = <Cvd0 e.X>;
}

// Divides the number by 10^9, which splits it into the high part and a group of nine digits.
$FUNC Cvd0 
{
    e.X = <Cvd1 <DrN (e.X) 1000000000>>;
}

// Writes the high part recursively, then the group of nine digits (padded with zeros by Cvd2).
$FUNC Cvd1
{
    (e.Y) = <Symb 10 e.Y>;
    e.X (e.Y) = <Cvd0 e.X> <Cvd2 <Symb 10 e.Y>>;
}

// Pads a group with leading zeros up to nine digits.
$FUNC Cvd2
{
    s.D1 s.D2 s.D3 s.D4 s.D5 s.D6 s.D7 s.D8 s.D9 = s.D1 s.D2 s.D3 s.D4 s.D5 s.D6 s.D7 s.D8 s.D9;
    e.X = <Cvd2 '0' e.X>;
}

//  <Is_White_Space s.Any> == True | False
// True when the symbol is a white space (see the specifier White_Spaces).
$FUNC Is_White_Space
{
    s(:White_Spaces:)._ = True;
    s._ = False;
}

//  <Trim e.Any> == e.Any′
// Removes the white spaces at both ends of the expression.
$FUNC Trim
{
    e.Any = <TrimL <TrimR e.Any>>;
}

//  <TrimL e.Any> == e.Any′
// Removes the white spaces at the beginning.
$FUNC TrimL
{
    s(:White_Spaces:)._ e.Any = <TrimL e.Any>;
    e._ = e._;
}

//  <TrimR e.Any> == e.Any′
// Removes the white spaces at the end.
$FUNC TrimR
{
    e.Any s(:White_Spaces:)._ = <TrimR e.Any>;
    e._ = e._;
}

/*
    <Type e.Any> == s.Type e.SubType e.Any
    s.Type ::= Void | Label | Number | Reference | Char | Brackets | OtherT
    e.SubType ::= Latin | Digit |
*/
// The type of the first term of the expression, put in front of the expression.
// For characters the subtype (Latin or Digit) is added when there is one.
$FUNC Type
{
    = Void;
    f.Symbol e._ = Label f.Symbol e._;
    n.Symbol e._ = Number n.Symbol e._;
    r.Symbol e._ = Reference r.Symbol e._;
    l.Symbol e._ = Char Latin l.Symbol e._;
    d.Symbol e._ = Char Digit d.Symbol e._;
    o.Symbol e._ = Char o.Symbol e._;
    (e.Expr) e._ = Brackets (e.Expr) e._;
    e._ = OtherT e._;
}

/*
    <Is_Type s.Type e.Any> == True s.Type e.Any | False s.Type e.Any
    s.Type ::= Void | Label | Number | Reference | Char | Latin | Digit | Brackets | OtherT
*/
// Checks the first term against the type: True or False is put in front of the type and the expression.
// OtherT is a term that has none of the other types.
$FUNC Is_Type
{
    Void = True Void;
    Void e._ = False Void e._;
    Label f.Symbol e._ = True Label f.Symbol e._;
    Label e._ = False Label e._;
    Number n.Symbol e._ = True Number n.Symbol e._;
    Number e._ = False Number e._;
    Reference r.Symbol e._ = True Reference r.Symbol e._;
    Reference e._ = False Reference e._;
    Char o.Symbol e._ = True Char o.Symbol e._;
    Char e._ = False Char e._;
    Latin l.Symbol e._ = True Latin l.Symbol e._;
    Latin e._ = False Latin e._;
    Digit d.Symbol e._ = True Digit d.Symbol e._;
    Digit e._ = False Digit e._;
    Brackets (e.Expr) e._ = True Brackets (e.Expr) e._;
    Brackets e._ = False Brackets e._;
    OtherT = False OtherT;
    OtherT f.Symbol e._ = False OtherT f.Symbol e._;
    OtherT n.Symbol e._ = False OtherT n.Symbol e._;
    OtherT r.Symbol e._ = False OtherT r.Symbol e._;
    OtherT o.Symbol e._ = False OtherT o.Symbol e._;
    OtherT (e.Expr) e._ = False OtherT (e.Expr) e._;
    OtherT e._ = True OtherT e._;
}

$END.
