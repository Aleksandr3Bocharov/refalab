//====================================================================
// Рефал-функции библиотеки РефалАБ.
//====================================================================

$START SETS;

$ENTRY SetW, SetW_Union, SetW_Intersect;
$ENTRY SetN, SetN_Union;
$EXTERN Map, NNorm, ExistW, True;

//  <SetW w.Item*> == w.Item*′
$FUNC SetW 
{
    e.Terms = <PurgeDuplicates e.Terms>;
}

//  <SetW_Union (w.Item1*) w.Item2*> == w.Item_Union*
$FUNC SetW_Union
{
    (e.Terms1) e.Terms2 = <SetW e.Terms1 e.Terms2>;
}

//  <SetW_Intersect (w.Item1*) w.Item2*> == w.Item_Intersect*
$FUNC SetW_Intersect
{
    (e.Terms1) e.Terms2 = <Map (Intersect e.Terms1) <SetW e.Terms2>>;
}

$FUNC Intersect
{
    e.Items1 w.Item2 = <Intersect_Aux <ExistW w.Item2 e.Items1> w.Item2>;
}

$FUNC Intersect_Aux
{
    True w.Item2 = w.Item2;
    e._ = ;
}

//  <SetN (e.Number)*> == (e.Number)*′
$FUNC SetN
{
    e.Numbers = <PurgeDuplicates <Map NormTerm e.Numbers>>;
}

$FUNC NormTerm
{
    (e.Number) = (<NNorm e.Number>);
}

//  <SetN_Union ((e.Number1)*) (e.Number2)*> == (e.Number_Union)*
$FUNC SetN_Union
{
    (e.Numbers1) e.Numbers2 = <SetN e.Numbers1 e.Numbers2>;
}

$FUNC PurgeDuplicates
{
    $RIGHT e.Items_B w.Repeated e.Items_E w.Repeated e.Uniques = <PurgeDuplicates e.Items_B w.Repeated e.Items_E> e.Uniques;
    e._ = e._;
}

$END.
