//====================================================================
// Рефал-функции библиотеки РефалАБ.
//====================================================================

$START SETS;

$ENTRY SetW;

//  <SetW w.Item*> == w.Item*′
$FUNC SetW 
{
    $RIGHT e.Items_B w.Repeated e.Items_E w.Repeated e.Uniques = <SetW e.Items_B w.Repeated e.Items_E> e.Uniques;
    e._ = e._;
}

$END.
