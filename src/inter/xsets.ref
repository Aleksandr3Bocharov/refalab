//====================================================================
// Рефал-функции библиотеки РефалАБ.
//====================================================================

$START SETS;

$ENTRY SetW, SetW_Union, SetW_Intersect, SetW_Diff;
$ENTRY SetN, SetN_Union, SetN_Intersect, SetN_Diff;
$EXTERN Map, NNorm, ExistW, True, False;
$EMPTY Intersection, Difference;

//  <SetW w.Item*> == w.Item*′
$FUNC SetW 
{
    e.Terms = <PurgeDuplicates e.Terms>;
}

//  <SetW_Union (w.Item1*) w.Item2*> == w.Item_Union*
$FUNC SetW_Union
{
    (e.Terms1) e.Terms2 = <SetW e.Terms1 e.Terms2>;
}

//  <SetW_Intersect (w.Item1*) w.Item2*> == w.Item_Intersect*
$FUNC SetW_Intersect
{
    (e.Terms1) e.Terms2 = <Set_Operation Intersection (<SetW e.Terms1>) e.Terms2>;
}

//  <SetW_Diff (w.Item1*) w.Item2*> == w.Item_Diff*
$FUNC SetW_Diff
{
    (e.Terms1) e.Terms2 = <Set_Operation Difference (<SetW e.Terms1>) e.Terms2>;
}

//  <SetN (e.Number)*> == (e.Number)*′
$FUNC SetN
{
    e.Numbers = <PurgeDuplicates <Map NormTerm e.Numbers>>;
}

$FUNC NormTerm
{
    (e.Number) = (<NNorm e.Number>);
}

//  <SetN_Union ((e.Number1)*) (e.Number2)*> == (e.Number_Union)*
$FUNC SetN_Union
{
    (e.Numbers1) e.Numbers2 = <SetN e.Numbers1 e.Numbers2>;
}

//  <SetN_Intersect ((e.Number1)*) (e.Number2)*> == (e.Number_Intersect)*
$FUNC SetN_Intersect
{
    (e.Numbers1) e.Numbers2 = <Set_Operation Intersection (<SetN e.Numbers1>) <SetN e.Numbers2>>;
}

//  <SetN_Diff ((e.Number1)*) (e.Number2)*> == (e.Number_Diff)*
$FUNC SetN_Diff
{
    (e.Numbers1) e.Numbers2 = <Set_Operation Difference (<SetN e.Numbers1>) <SetN e.Numbers2>>;
}

$FUNC PurgeDuplicates
{
    $RIGHT e.Items_B w.Repeated e.Items_E w.Repeated e.Uniques = <PurgeDuplicates e.Items_B w.Repeated e.Items_E> e.Uniques;
    e._ = e._;
}

$FUNC Set_Operation
{
    s.Set_Operation (w.Item1 e.Items1_E) e.Items2 = <Set_Operation_Aux s.Set_Operation <ExistW w.Item1 e.Items2> (e.Items1_E)>;
    s._ () e.__ = ;
}

$FUNC Set_Operation_Aux
{
    Intersection True w.Item1 e.Items2 (e.Items1_E) = w.Item1 <Set_Operation Intersection (e.Items1_E) e.Items2>;
    Difference False w.Item1 e.Items2 (e.Items1_E) = w.Item1 <Set_Operation Difference (e.Items1_E) e.Items2>;
    s.Set_Operation s._ w.__ e.Items2 (e.Items1_E) = <Set_Operation s.Set_Operation (e.Items1_E) e.Items2>;
}

$END.
