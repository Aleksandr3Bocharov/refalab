//====================================================================
// Refal functions of the RefalAB library.
//====================================================================

$START SYSTEM2;

$ENTRY ArgList;
$EXTERN P1, Arg;

//  <ArgList> == (s(o).Arg+)*
// The list of all the command line arguments: every argument is in the brackets, as characters.
// The argument 0 (the name of the program) is not included.
$FUNC ArgList
{
    = <ArgList_Aux 1>;
}

// Takes the argument number s.Next, the next number is made by P1.
$FUNC ArgList_Aux
{
    s.Next = <SwArgList_Aux <P1 s.Next> <Arg s.Next>>;
}

// Switch: an empty answer of Arg ends the list, otherwise the argument is added and the list goes on.
$FUNC SwArgList_Aux
{
    s.Next = ;
    s.Next e.Arg = (e.Arg) <ArgList_Aux s.Next>;
}

$END.
