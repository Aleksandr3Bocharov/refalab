//====================================================================
// Refal functions of the RefalAB library.
// Specifiers of the RefalAB library.
//====================================================================

$START ARIPHMETICS2;

$ENTRY Inc, Dec;
$ENTRY Max_Number, Is_Max_Number;
$EXTERN Add, Sub;
$EXTERN True, False;

// The specifier Max_Number: the largest macrodigit.
$SPEC Max_Number 4294967295;

/* 
    <Inc e.Number> == v.Number1
    e.Number ::= '+' s(n).Number+ | '-' s(n).Number+ | s(n).Number*
    v.Number1 ::= '-'? s(n).Number+ 
*/
// Increment of a long integer.
$FUNC Inc
{
    e.Number = <Add (e.Number) 1>;
}

/*
    <Dec e.Number> == v.Number1
    e.Number ::= '+' s(n).Number+ | '-' s(n).Number+ | s(n).Number*
    v.Number1 ::= '-'? s(n).Number+
*/
// Decrement of a long integer.
$FUNC Dec 
{
    e.Number = <Sub (e.Number) 1>;
}

//  <Is_Max_Number s.Any> == True | False
// True when the symbol is the largest macrodigit.
$FUNC Is_Max_Number
{
    s(:Max_Number:)._ = True;
    s._ = False;
}

$END.
