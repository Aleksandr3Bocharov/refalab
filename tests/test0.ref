// Test 0: a general check of the library. It runs the groups of calls and prints the arguments and
// the results, which are compared with the expected ones by eye: boxes (Prsw), files (Prvv),
// the store (Prkop), arithmetic and lexical functions (Dal1, Dal) and specifiers (Prspe).
$START TEST0;

$ENTRY Go;
$EXTERN Add, Sub, Mul, Dr, M1, P1, Numb, Symb;
$EXTERN First, Last, Length, LengthW;
$EXTERN New, Wtr, Rdr, Ptr, Gtr, Swr;
$EXTERN Print, Prout, Proutm;
$EXTERN FOpen, FClose, FGetS, FPutS, Rename, Remove_File;
$EXTERN Br, Rp, Dg, DgAll, Cp;
$EMPTY Tra, Em1, Em2, Em3, Pus;
$SWAP Sw;

$SPEC Bspe '2134' Pus;

// Div through Dr: the quotient only.
$FUNC Div 
{
    e.N = <Div0 <Dr e.N>>;
}

// Drops the remainder.
$FUNC Div0
{
    e.N (e._) = e.N;
}

// Runs all the groups of checks.
$FUNC Go 
{
    =
        <Prsw>
        <Prvv>
        <Prkop>
        <Dal1>
        <Prspe Pus 'as01a432l7l' Em3>;
}

//      Check of the type specifiers: every symbol of the string is classified.
$FUNC Prspe
{
    e.E s(Em1 Em2 Em3).S = <Prout ' symbol-&em' s.S> <Prspe e.E>;
    s(:Bspe:).S e.K = <Prout ' symbol-b=' s.S> <Prspe e.K>;
    $RIGHT e.H s('l7').S = <Prout ' symbol-l=' s.S> <Prspe e.H>;
    s.S e.K = <Prout '  symbol=' s.S> <Prspe e.K>;
    = ;
}

//      Check of Mul, P1, Length, Lengthw, First, Last, Numb, Symb, Add, M1, Sub
// Checks Mul, Div, P1 and the groups of Dal.
$FUNC Dal1
{
    =
        <Prmu (126) 2>
        <Prmu (16777216) 64> 
        <Prmu (4294967295) 1> 
        <Prmu (16777216) 512>   
        <Prdl (65536) 4>
        <Prdl (65536) 777> 
//      <Prdl (1) 0>       negative test (recognition is impossible)
        <Prp1 4>
        <Prp1 65536>
        <Prp1 128> 
//      <Prp1 4294967295>      negative test (recognition is impossible)
        <Dal>;
}

// Checks Length, Lengthw, First, Last, Numb, Symb, Add, M1 and Sub.
$FUNC Dal
{
    = 
        <Prln 0 1 '345678'>
        <Prln (0 1) '345678'>
        <Prfe 3 '1234567'>
        <Prla 3 '123456'>
        <Prfe 1 2> 
        <Prla 3 1 2 3 '567'> 
//      <Prfe '123'>          negative test (recognition is impossible)
//      <Prla '123'>          negative test (recognition is impossible)
        <Prnu '125'>
        <Prnu '76666'>
        <Prnu '4294967295'> 
//      <Prnu '4394967295'>                 negative test (recognition is impossible)
        <Prnu '-45'> 
        <Prsy 10 5678>
        <Prsy 10 4294967295> 
        <Prad (128) 456>
        <Prad (4294967295) 2>
        <Prm1 3>
        <Prm1 128>
        <Prm1 4294967295> 
        <Prsu (4294967295) 2>
        <Prsu (2) 456>;
}

// Check of Mul.
$FUNC Prmu
{
    e.N = <Prow Mul e.N>;
}

// Check of Numb.
$FUNC Prnu
{
    e.N = <Prow Numb e.N>;
}

// Check of Symb.
$FUNC Prsy
{
    e.N = <Prow Symb e.N>;
}

// Check of Add.
$FUNC Prad
{
    e.N = <Prow Add e.N>;
}

// Check of Sub.
$FUNC Prsu
{
    e.N = <Prow Sub e.N>;
}

// Check of M1.
$FUNC Prm1
{
    e.N = <Prow M1 e.N>;
}

// Check of Div.
$FUNC Prdl
{
    e.N = <Prow Div e.N>;
}

// Check of P1.
$FUNC Prp1
{
    e.N = <Prow P1 e.N>;
}

// Check of First.
$FUNC Prfe
{
    e.E = <Prow First e.E>;
}

// Check of Last.
$FUNC Prla
{
    e.E = <Prow Last e.E>;
}

// Prints the call (the function and the arguments) and its result.
$FUNC Prow
{
    s.F e.E = <Proutm s.F ', whod=' e.E '  wyh=' < s.F e.E>>;
}

// Checks the store: Br, Rp, Dg, Cp and DgAll, also with a function name as the key.
$FUNC Prkop 
{  
    = 
        <Br 'cc' '=' 123>
        <Br 'mmm' '=' '345'>
        <Rp 'mmm' '=' '879'>
        <Dg 'mmm'>
        <Cp 'cc'>
        <DgAll>
        <Br Tra '=' '765'>
        <Rp Tra '=' 16777215>
        <Dg Tra>;
}

// Checks the files: writing, appending, renaming, reading and removing.
$FUNC Prvv
{   
    =
        <FOpen 'w' 0 'lala.put'>
        <FPutS 0 ' str 1\n'>
        <FPutS 0 ' str 2\n'>
        <FClose 0>
        <FOpen 'a' 1 'lala.put'> 
        <FPutS 1 ' str 3\n'>
        <FClose 1> 
        <Rename 'lala.put' 0 'lala.get'>
        <FOpen 'r' 4 'lala.get'>
        <Print <FGetS 4>>
        <Print <FGetS 4>>
        <Print <FGetS 4>>
        <FClose 4>
        <Remove_File 'lala.get'>;
}

// Checks the boxes: the static box Sw and a dynamic one (see Sw1).
$FUNC Prsw
{   
    = 
        <Sw1 <New 123456>>
        <Wtr Sw 123456>
        <Ptr Sw '0'>
        <Rdr Sw>
        <Gtr Sw>;
}

// Checks a dynamic box: Ptr, Rdr and Wtr.
$FUNC Sw1 
{
    r.X = 
        <Ptr r.X 2>
        <Rdr r.X>
        <Wtr r.X 12>
        <Sw2 r.X>;
}

$FUNC Sw2 
{
    r.X =
        <Ptr r.X 3>
        <Rdr r.X>
        <Gtr r.X>
        <Swr r.X '0' 4294967295 '0'>
        <Prout <Rdr r.X>>;
}

$FUNC Prln
{
    e.E = <Prout ' length,lengthw: whod=' e.E '  wyh=' <Length e.E> '  wyh-w=' <LengthW e.E>>;
}

$END.
