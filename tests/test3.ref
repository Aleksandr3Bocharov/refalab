// Test 3: the store (Br, Rp, Dg, DgAll, Cp) and the boxes (New, Wtr, Rdr, Ptr, Gtr, Swr).
// The expected result is written in the text printed before it (d.b. = it must be).
$START TEST3;

$ENTRY Go;
$EXTERN New, Wtr, Rdr, Ptr, Gtr, Swr;
$EXTERN Print, Proutm, Prout;
$EXTERN Br, Rp, Dg, DgAll, Cp;
$EMPTY Tra;
$SWAP Sw;

// Checks the store and the static box Sw.
$FUNC Go
{
    =
        <Br 'cc' '=' 123> 
        <Br 'mmm' '=' '345'> 
        <Br 'mmm' '=' '879'> 
        <Proutm ' d.b. 879:  ' <Dg 'mmm'>> 
        <Rp 'cc' '=' '1'> 
        <Cp 'cc'> 
        <Proutm ' d.b. 345 i 1: ' <DgAll>> 
        <Rp Tra '=' '765'>
        <Rp Tra '=' 4294967295> 
        <Proutm ' d.b. 4294967295: ' <Dg Tra>> 
        <Sw1 <New 123456>> 
        <Wtr Sw 123456>
        <Wtr Sw '0'> 
        <Proutm ' d.b. 0 i 0: ' <Rdr Sw> <Gtr Sw> <Rdr Sw>>;
}

// Checks a dynamic box: exchange (Swr) and writing (Wtr).
$FUNC Sw1 
{
    r.X =
        <Proutm ' d.b. 123456: ' <Swr r.X 2>> 
        <Proutm ' d.b. 2: ' <Rdr r.X>> 
        <Wtr r.X 12>
        <Sw2 r.X>;
}

// Checks Ptr, Rdr, Gtr and the exchange with an empty box.
$FUNC Sw2 
{
    r.X =
        <Ptr r.X 3> 
        <Proutm ' d.b. 2*(12 3): ' <Rdr r.X> <Gtr r.X>>
        <Prout ' d.b. pusto: ' <Swr r.X '0' 4294967295 '0'>> 
        <Prout <Rdr r.X>>;
}

$END.
