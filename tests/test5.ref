// Test 5: the conversion of numbers: Numb (text to a number) and Symb (a number to text)
// for decimal, octal and hexadecimal forms.
$START TEST5;

$ENTRY Go;
$EXTERN Prout, Numb, Symb;

// Runs the checks of Numb and Symb.
$FUNC Go
{
    =
        <P <Numb '-1000'>> 
        <P <Numb>> 
        <P <Numb '000000000000000000000000000000001'>> 
        <P <Numb '-000000000000000000000000000000001'>> 
        <P <Numb '+000000000000000000000000000000001'>> 
        <P <Numb '1000000000'>> 
        <P <Numb '4294967295'>> 
        <P <Numb '+0xff'>> 
        <Prout '0:' <Symb 10>> 
        <Prout '0:' <Symb 10 0>> 
        <Prout '1:' <Symb 10 0 1>> 
        <Prout '1:' <Symb 10 0 0 0 0 1>> 
        <Prout '-01:' <Symb 8 '-' 0 0 0 0 1>> 
        <Prout '0x1:' <Symb 16 '+' 0 0 0 0 1>> 
        <Prout <Symb 4294967295>> 
//  Negative tests: recognition is impossible for these calls.
        <Numb '+'>
        <Numb '-'>
        <Numb '4294967296'> 
        <Numb '-4294967296'> 
        <Symb 10 '+'>
        <Symb 10 '-'>
        <Symb 10 1 0> 
        <Symb 10 '-' 1 0>;
}

// Prints a number and its text form.
$FUNC P 
{
    e.N = <Prout e.N ' : ' <Symb 10 e.N>>;
}

$END.
