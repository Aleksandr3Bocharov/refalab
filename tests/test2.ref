// Test 2: files and function names: writing, appending, renaming, reading and removing a file,
// and the conversions between a function and its name (FuncTab, ChartoF, FtoChar).
$START TEST2;

$ENTRY Go;
$EXTERN FOpen, FClose, FGetS, FPutS, Rename, Remove_File;
$EXTERN Print, Prout, FtoChar, ChartoF, FuncTab;
$EMPTY Ffff;

// Registers the function Prout in the table of names and calls it by its name, then works with a file.
// The empty function Ffff has the name 'FFFF', and Tttt is registered and called by name too.
$FUNC Go
{
    =
        <FuncTab Prout> 
        < <ChartoF 'prout'> ' eto prout'> 
        < <ChartoF 'PROUT'> ' eto PROUT'> 
//      <FOpen 'r' 10 'bb'>     !!  negative test  !!
        <FOpen 'w' 0 'lala.tes'> 
        <FPutS 0 ' str 1\n'>
        <FPutS 0 ' str 2\n'>
        <FClose 0> 
        <FOpen 'a' 1 'lala.tes'> 
        <FPutS 1  ' str 3\n'> 
        <FClose 1> 
        <Rename 'lala.tes' 0 'lala.tos'> 
        <FOpen 'r' 4 'lala.tos'> 
        <Print <FGetS 4>>
        <Print <FGetS 4>> 
        <Print <FGetS 4>> 
        <Print <FGetS 4>>
        <FClose 4> 
        <Prout ' d.b. ffff: ' <FtoChar Ffff>> 
        <FuncTab Tttt> 
        < <ChartoF 'tttt'> 'werno'> 
        <Remove_File 'lala.tos'>;
}

// A function that is called by its name.
$FUNC Tttt
{
    e.E = <Prout e.E>;
}

$END.
